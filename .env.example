# Namuna — gitga yuklanadi. Nusxa: cp .env.example .env
# Lokal: Vite proxy uchun /v2/api
# Prod: http://back.intalim.uz/v2/api

VITE_APP_NAME=EAVTOTA'LIM
VITE_PATH_PREFIX=/api
VITE_PATH_PREFIX_V2=/v2/api
VITE_PATH_PREFIX_FILE=http://back.intalim.uz/
# Profil / MSPD rasmlari (eski PATH_PREFIX_FILE_WITHOUT_SLESH)
VITE_PATH_PREFIX_FILE_HOST=https://back.eavtotalim.uz
VITE_IS_PROD=false
